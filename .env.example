# Postgres — Neon Database Connections
# Direct connection (for schema migrations & seeding)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full"
# Pooled connection (for Next.js runtime queries)
DATABASE_URL_POOLED="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Authentication (minimum 32 characters random secret)
AUTH_SECRET="replace-with-a-64-character-cryptographically-secure-random-hex-key"

# Initial Admin Bootstrap (used by db:seed)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="ChangeMe_StrongPassword123!"

# Unsplash API (Demo tier: 50 req/hour, max 30 photos/req - managed by UnsplashQuotaWorker)
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
UNSPLASH_APP_NAME="goku_junior_nextjs"

# Cloudinary Single-Slot Avatar Storage
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Optional Secondary Image Provider Toggle ("true" | "false")
ENABLE_SECONDARY_PROVIDER="false"
